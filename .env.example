# Copy to .env and fill in real values. Never commit .env.
# Single source of truth for every .env in this repo (docker-compose.yml,
# and local non-Docker dev of web/ and backend/) — do not create per-service
# .env files; add new vars here instead.

# ---- docker-compose.yml (Coolify injects these at deploy time) ----

# Shared secret required by the api service to authenticate requests.
# Send it from the client as: X-API-Key: <value>  (or Authorization: Bearer <value>)
API_KEY=change-me-to-a-long-random-value

# Base URL the web (frontend) service uses to reach the api service.
# Internal Docker network default; override only for non-Docker/local dev.
API_URL=http://api:8000

# ---- web/ local dev (next dev, run outside Docker) ----
# Same names as web/lib/api.ts reads (no NEXT_PUBLIC_ prefix — server-only,
# never bundled to the browser). Copy this file to web/.env.local and adjust:
# MTG_API_URL below should point at the locally-running uvicorn backend
# instead of the Docker-internal API_URL above.

# Base URL of the FastAPI backend (uvicorn mtg_analyzer.api.app:app --reload).
MTG_API_URL=http://localhost:8000

# Same value as API_KEY above, only if the local backend has one set.
MTG_API_KEY=
