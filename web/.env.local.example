# Copie para .env.local e preencha. Nunca commitar .env.local.
#
# Lidas somente no servidor Next.js (Server Components / Route Handlers) —
# de propósito SEM prefixo NEXT_PUBLIC_, para nunca ir parar no bundle do
# browser. Ver web/lib/api.ts.

# URL base da API FastAPI (mtg_analyzer.api.app). Em dev local, o backend
# roda em http://localhost:8000 (uvicorn mtg_analyzer.api.app:app --reload).
MTG_API_URL=http://localhost:8000

# Mesmo valor de API_KEY setado no backend (ver .env.example na raiz do
# repo). Se o backend não tiver API_KEY setado, pode deixar em branco.
MTG_API_KEY=
